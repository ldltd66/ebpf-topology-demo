FROM rust:1.70-buster AS builder
RUN sed -i 's|deb.debian.org|archive.debian.org|g; /security.debian.org/d' /etc/apt/sources.list || true
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo-legacy.toml ./Cargo.toml
COPY src/main-legacy.rs ./src/main.rs
RUN cargo build --release

FROM debian:buster-slim
RUN sed -i 's|deb.debian.org|archive.debian.org|g; /security.debian.org/d' /etc/apt/sources.list || true
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates libssl1.1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/risk-engine .
EXPOSE 8080
HEALTHCHECK --interval=10s CMD curl -f http://localhost:8080/health || exit 1
CMD ["./risk-engine"]
